APP_NAME=async-task-engine
ENVIRONMENT=local
LOG_LEVEL=INFO

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MAIN_QUEUE=tasks_primary
RABBITMQ_DLQ_QUEUE=tasks_dead_letter

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_LOCK_TTL_SECONDS=300

BATCH_CHUNK_SIZE=100
MAX_TASK_RETRIES=3
RATE_LIMIT_PER_SECOND=100.0
OPS_API_KEY=ops-dev-secret
